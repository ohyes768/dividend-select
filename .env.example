# 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# 推荐：实际部署用 .env.local（已在 .gitignore），优先级最高

# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# API Gateway 配置（可选）
# API_GATEWAY_URL=http://localhost:8010

# 阿里云行情 API（K线数据，APPCODE 鉴权）
# 用于 DividendCalculator._get_price_from_aliyun()
# ALIYUN_API_HOST=http://alirmcom2.market.alicloudapi.com
# ALIYUN_API_PATH=/query/comkm
# ALIYUN_API_APPCODE=your_appcode_here

# 钉钉机器人 webhook（挡位监控推送，留空则跳过推送只写历史）
# 获取：钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 外部 agent 调用 batch 接口的鉴权 token
# 接口：POST /api/dividend/favorites/alerts/batch
# 调用方必带 header：X-API-Token: <此处的值>
# 留空或未设置 → batch 接口返回 503；缺/错 token → 401
# 实际部署写入 .env.local（已 .gitignore），不要 commit 真实 token
AGENT_API_TOKEN=